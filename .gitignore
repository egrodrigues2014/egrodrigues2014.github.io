# Hugo build output and caches
/public/
/resources/
.hugo_build.lock

# Dependencies
/node_modules/

# Editor and local tooling
.vscode/
.claude/
# Regenerated by Hugo on every install, with an absolute path into the local
# module cache: machine-specific, editor-only, and it leaks a home directory.
assets/jsconfig.json

# OS cruft
.DS_Store
Thumbs.db

# Private source material. The LinkedIn profile export carries a phone
# number and often a postal address; this repo is public and its history is
# permanent, so no PDF is tracked by default.
private/
*.pdf
# ...except the curated CVs that are meant to be published.
!static/files/cv-*.pdf
